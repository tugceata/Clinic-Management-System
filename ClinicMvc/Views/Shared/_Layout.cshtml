@using ClinicMvc.Data
@inject AppDbContext Db

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - ClinicPro</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ClinicMvc.styles.css" asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>

    @{
        var role = Context.Session.GetString("Role");
        var userName = Context.Session.GetString("UserName");

        int unread = 0;

        if (role == "Doctor" || role == "Patient")
        {
            int uid = Context.Session.GetInt32("UserId") ?? 0;

            unread = Db.Notifications.Count(n =>
                n.TargetRole == role &&
                n.TargetUserId == uid &&
                !n.IsRead);
        }
    }

    <header>
        <nav class="navbar navbar-expand-lg clinic-navbar">

            <div class="container">

                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-heart-pulse-fill me-2"></i>
                    ClinicPro
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">

                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Ana Sayfa
                            </a>
                        </li>

                    </ul>

                    <ul class="navbar-nav align-items-center">

                        @if (role == null)
                        {
                            <li class="nav-item me-2">
                                <a class="btn btn-outline-primary"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Giriş Yap
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="btn btn-primary"
                                   asp-controller="Account"
                                   asp-action="Register">
                                    Kaydol
                                </a>
                            </li>
                        }
                        else
                        {
                            @if (role == "Doctor" || role == "Patient")
                            {
                                <li class="nav-item me-3">

                                    <a asp-controller="Notification"
                                       asp-action="Index"
                                       class="notification-icon position-relative">

                                        <i class="bi bi-bell-fill"></i>

                                        @if (unread > 0)
                                        {
                                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                                @unread
                                            </span>
                                        }

                                    </a>

                                </li>
                            }

                            <li class="nav-item me-3">
                                <span class="role-chip">
                                    @role
                                </span>
                            </li>

                            <li class="nav-item me-3">
                                <span class="user-chip">
                                    <i class="bi bi-person-circle me-1"></i>
                                    @userName
                                </span>
                            </li>

                            <li class="nav-item">
                                <a class="btn btn-danger"
                                   asp-controller="Account"
                                   asp-action="Logout">
                                    Çıkış
                                </a>
                            </li>
                        }

                    </ul>

                </div>

            </div>

        </nav>
    </header>

    <main class="page-content">
        <div class="container py-4">

            @RenderBody()

        </div>
    </main>

    <footer class="clinic-footer">

        <div class="container">

            <div class="row">

                <div class="col-md-6">

                    <h5 class="fw-bold">
                        ClinicPro
                    </h5>

                    <p class="text-muted mb-0">
                        Dijital Klinik Yönetim Sistemi
                    </p>

                </div>

                <div class="col-md-6 text-md-end">

                    <p class="mb-0 text-muted">
                        © 2026 ClinicPro
                    </p>

                </div>

            </div>

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>